{
    "compilerOptions" : {
        "target": "ES2022",
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "strict" : true,
        "esModuleInterop": true,
        "skipLibCheck" : true,
        "noEmit" : true,
        "types" : ["node"]
    },
    "include" : ["src"],
    "exclude" : ["node_modules" , "babel.config.js", "metro.config.js", "jest.config.js", "android", "ios", "server"]
}