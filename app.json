{
  "expo": {
    "name": "GhostRacer",
    "slug": "GhostRacer",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "ghostracer",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "com.darealiferatsteam.GhostRacer"
    },
    "android": {
      "package": "com.darealiferatsteam.GhostRacer",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": ["android.permission.CAMERA"],
      "package": "com.darealiferatsteam.GhostRacer"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      "expo-font",
      "expo-image",
      "expo-status-bar",
      "expo-web-browser",
      "@rnmapbox/maps",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow GhostRacer to use your photos so you can choose a profile picture.",
          "cameraPermission": "Allow GhostRacer to use the camera for your profile photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow GhostRacer to access your location while you are using the app.",
          "locationAlwaysAndWhenInUsePermission": "Allow GhostRacer to access your location even when you are not using the app.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "db0aac8b-57c7-44e0-ade7-84284ec74f9c"
      }
    }
  }
}
